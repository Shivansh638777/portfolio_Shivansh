<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Shivansh Portfolio</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, Helvetica, sans-serif;
    }

    body{
      background:#0a0a0a;
      color:white;
      overflow-x:hidden;
    }

    html{
      scroll-behavior:smooth;
    }

    nav{
      width:100%;
      padding:20px 10%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      position:fixed;
      top:0;
      background:rgba(0,0,0,0.7);
      backdrop-filter:blur(10px);
      z-index:1000;
    }

    nav h1{
      font-size:28px;
      color:#00ffd5;
    }

    nav ul{
      display:flex;
      gap:25px;
      list-style:none;
    }

    nav ul li a{
      color:white;
      text-decoration:none;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#00ffd5;
    }

    .hero{
      height:100vh;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      text-align:center;
      padding:20px;
    }

    .hero h2{
      font-size:70px;
      margin-bottom:20px;
    }

    .hero span{
      color:#00ffd5;
    }

    .hero p{
      max-width:700px;
      color:#bdbdbd;
      font-size:20px;
      line-height:1.7;
    }

    .btns{
      margin-top:35px;
      display:flex;
      gap:20px;
      flex-wrap:wrap;
    }

    .btn{
      padding:14px 28px;
      background:#00ffd5;
      color:black;
      text-decoration:none;
      border-radius:40px;
      font-weight:bold;
      transition:0.3s;
    }

    .btn:hover{
      transform:scale(1.05);
    }

    section{
      padding:100px 10%;
    }

    .title{
      font-size:45px;
      margin-bottom:50px;
      color:#00ffd5;
    }

    .about p{
      font-size:20px;
      line-height:1.8;
      color:#cfcfcf;
    }

    .skills-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:25px;
    }

    .skill-card{
      background:#151515;
      padding:30px;
      border-radius:20px;
      transition:0.3s;
      border:1px solid #222;
    }

    .skill-card:hover{
      transform:translateY(-8px);
      border-color:#00ffd5;
    }

    .skill-card h3{
      margin-bottom:15px;
      font-size:24px;
    }

    .skill-card p{
      color:#bcbcbc;
      line-height:1.6;
    }

    .project-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
      gap:30px;
    }

    .project-card{
      background:#151515;
      padding:30px;
      border-radius:20px;
      border:1px solid #222;
      transition:0.3s;
    }

    .project-card:hover{
      transform:translateY(-10px);
      border-color:#00ffd5;
    }

    .project-card h3{
      margin-bottom:15px;
      font-size:28px;
    }

    .project-card p{
      color:#c4c4c4;
      line-height:1.7;
    }

    .contact{
      text-align:center;
    }

    .contact h2{
      margin-bottom:25px;
    }

    .contact p{
      font-size:22px;
      margin-bottom:12px;
      color:#c9c9c9;
    }

    footer{
      text-align:center;
      padding:30px;
      border-top:1px solid #222;
      color:#8d8d8d;
    }

    @media(max-width:768px){

      .hero h2{
        font-size:45px;
      }

      nav{
        padding:20px;
      }

      nav ul{
        gap:12px;
      }

      .title{
        font-size:35px;
      }

    }

  </style>
</head>

